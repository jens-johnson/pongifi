/**
 * █████████████████████████████████████████████████████████████████████████████████████████████████████████████████████
 *
 *                                  ██████╗  ██████╗ ███╗   ██╗ ██████╗ ██╗███████╗██╗
 *                                  ██╔══██╗██╔═══██╗████╗  ██║██╔════╝ ██║██╔════╝██║
 *                                  ██████╔╝██║   ██║██╔██╗ ██║██║  ███╗██║█████╗  ██║
 *                                  ██╔═══╝ ██║   ██║██║╚██╗██║██║   ██║██║██╔══╝  ██║
 *                                  ██║     ╚██████╔╝██║ ╚████║╚██████╔╝██║██║     ██║
 *                                  ╚═╝      ╚═════╝ ╚═╝  ╚═══╝ ╚═════╝ ╚═╝╚═╝     ╚═╝
 *
 * █████████████████████████████████████████████████████████████████████████████████████████████████████████████████████
 * ███████████████████████████████████████████████████ .env.example ████████████████████████████████████████████████████
 *
 * Placeholder environment variables for local development. Real values live in Vercel; this file never holds a secret.
 *
 * █████████████████████████████████████████████████████████████████████████████████████████████████████████████████████
 */

# Neon serverless Postgres; use the POOLED connection string
DATABASE_URL=

# Upstash Redis (REST transport)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Google OIDC; read at request time by nuxt-auth-utils. The redirect URI is the route holding
# defineOAuthGoogleEventHandler (/auth/google) and must be registered with Google verbatim; Google
# rejects wildcards, so preview deployments pin the callback to the fixed preview host below.
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google

# Secret used to seal the session cookie; generate with `openssl rand -base64 32`
NUXT_SESSION_PASSWORD=

# Canonical origin for this environment
NUXT_PUBLIC_SITE_URL=http://localhost:3000
