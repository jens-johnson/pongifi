{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "#shared/*": ["./shared/*"],
      "#utils/*": ["./server/utils/*"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["env.d.ts", "drizzle.config.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
